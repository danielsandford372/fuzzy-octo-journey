# Transit Tracker Configuration

# Database path
DATABASE_PATH=transit_tracker.db

# Update interval in seconds (default: 30 seconds)
UPDATE_INTERVAL=30

# ==================== TRANSIT SYSTEM API KEYS ====================

# MTA (New York City) - Get key at https://api.mta.info/
MTA_NYC_API_KEY=your_mta_api_key_here

# BART (San Francisco Bay Area) - Get key at https://api.bart.gov/docs/overview/index.aspx
BART_API_KEY=your_bart_api_key_here

# MBTA (Boston) - Get key at https://api-v3.mbta.com/
MBTA_API_KEY=your_mbta_api_key_here

# CTA (Chicago) - No API key required
# (CTA feeds are publicly accessible)

# WMATA (Washington DC) - Get key at https://developer.wmata.com/
WMATA_API_KEY=your_wmata_api_key_here

# LA Metro (Los Angeles) - No API key required
# (LA Metro feeds are publicly accessible)
